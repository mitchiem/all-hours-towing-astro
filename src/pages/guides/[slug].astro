---
import MainLayout from '../../layouts/MainLayout.astro';
import { guides } from '../../data/guides';

export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide }
  }));
}

const { guide } = Astro.props;

const guideSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": guide.h1,
      "description": guide.description,
      "author": {
        "@type": "Organization",
        "name": "All Hours Towing Macon GA",
        "url": "https://allhourstowingmaconga.com"
      },
      "publisher": {
        "@type": "Organization",
        "name": "All Hours Towing Macon GA",
        "telephone": "+1-478-500-8118"
      },
      "mainEntityOfPage": `https://allhourstowingmaconga.com/guides/${guide.slug}`
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://allhourstowingmaconga.com/" },
        { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://allhourstowingmaconga.com/guides" },
        { "@type": "ListItem", "position": 3, "name": guide.title }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": guide.faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<MainLayout
  title={guide.pageTitle}
  description={guide.description}
  schema={guideSchema}
>
  <section class="section bg-towing-dark text-white">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <nav class="text-sm mb-4">
          <a href="/" class="text-gray-300 hover:text-white">Home</a>
          <span class="mx-2">/</span>
          <a href="/guides" class="text-gray-300 hover:text-white">Guides</a>
          <span class="mx-2">/</span>
          <span class="text-white">{guide.title}</span>
        </nav>
        <h1 class="text-3xl md:text-5xl font-bold mb-6">{guide.h1}</h1>
        <p class="text-xl text-gray-300">{guide.subtitle}</p>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <p class="text-towing-gray text-lg mb-8">{guide.intro}</p>

        {guide.sections.map((section) => (
          <div class="mb-10">
            <h2 class="text-xl md:text-2xl font-bold mb-3">{section.heading}</h2>
            {section.body.map((paragraph) => (
              <p class="text-towing-gray mb-4">{paragraph}</p>
            ))}
          </div>
        ))}

        <h2 class="text-xl md:text-2xl font-bold mb-4">Frequently Asked Questions</h2>
        <div class="space-y-4 mb-10">
          {guide.faqs.map((faq) => (
            <div class="bg-gray-50 rounded-lg p-5">
              <h3 class="font-bold mb-2">{faq.question}</h3>
              <p class="text-towing-gray">{faq.answer}</p>
            </div>
          ))}
        </div>

        <div class="grid md:grid-cols-3 gap-6 mb-10">
          <div class="bg-gray-50 rounded-lg p-6">
            <h3 class="font-bold mb-3">Related Services</h3>
            <ul class="space-y-2">
              {guide.relatedServices.map((link) => (
                <li><a href={link.href} class="text-towing-red hover:underline">{link.name}</a></li>
              ))}
            </ul>
          </div>
          <div class="bg-gray-50 rounded-lg p-6">
            <h3 class="font-bold mb-3">Related Articles</h3>
            <ul class="space-y-2">
              {guide.relatedBlogPosts.map((link) => (
                <li><a href={link.href} class="text-towing-red hover:underline">{link.name}</a></li>
              ))}
            </ul>
          </div>
          <div class="bg-gray-50 rounded-lg p-6">
            <h3 class="font-bold mb-3">Service Areas</h3>
            <ul class="space-y-2">
              {guide.relatedLocations.map((link) => (
                <li><a href={link.href} class="text-towing-red hover:underline">{link.name}</a></li>
              ))}
            </ul>
          </div>
        </div>

        <div class="bg-towing-red text-white rounded-lg p-8 text-center">
          <h3 class="text-xl font-bold mb-3">Need a Tow Right Now?</h3>
          <p class="mb-6">24/7 live dispatch. Fast, transparent pricing in Macon, Warner Robins & Byron.</p>
          <a href="tel:+14785008118" class="inline-block bg-white text-towing-red font-bold px-6 py-3 rounded-lg">Call (478) 500-8118</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
