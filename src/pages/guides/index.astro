---
import MainLayout from '../../layouts/MainLayout.astro';
import { guides } from '../../data/guides';

const guidesSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": "Towing & Roadside Assistance Guides for Macon, GA",
      "description": "In-depth towing and roadside assistance guides for Macon, Warner Robins and Byron, Georgia from All Hours Towing.",
      "url": "https://allhourstowingmaconga.com/guides"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://allhourstowingmaconga.com/" },
        { "@type": "ListItem", "position": 2, "name": "Guides" }
      ]
    },
    {
      "@type": "ItemList",
      "name": "Macon Towing Guides",
      "itemListElement": guides.map((guide, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": guide.title,
        "url": `https://allhourstowingmaconga.com/guides/${guide.slug}`
      }))
    }
  ]
};
---

<MainLayout
  title="Towing & Roadside Assistance Guides | Macon, GA | All Hours Towing | (478) 500-8118"
  description="In-depth towing and roadside guides for Macon, Warner Robins and Byron GA: costs, laws, safety and how to choose. Call (478) 500-8118."
  schema={guidesSchema}
>
  <section class="section bg-towing-dark text-white">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">Towing & Roadside Assistance Guides</h1>
        <p class="text-xl text-gray-300">
          In-depth resources for drivers across Macon, Warner Robins and Byron, Georgia.
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        {guides.map((guide) => (
          <a
            href={`/guides/${guide.slug}`}
            class="block bg-gray-50 rounded-xl p-8 hover:shadow-lg transition-shadow"
          >
            <h2 class="text-xl font-bold mb-3 text-gray-900">{guide.title}</h2>
            <p class="text-towing-gray mb-4">{guide.description}</p>
            <span class="text-towing-red font-medium inline-flex items-center gap-2">
              Read guide
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-towing-red">
    <div class="container text-center">
      <h2 class="text-3xl font-bold text-white mb-4">Need Help Right Now?</h2>
      <p class="text-white text-lg mb-6">24/7 live dispatch across Middle Georgia.</p>
      <a href="tel:+14785008118" class="inline-block bg-white text-towing-red font-bold px-8 py-4 rounded-lg">Call (478) 500-8118</a>
    </div>
  </section>
</MainLayout>
