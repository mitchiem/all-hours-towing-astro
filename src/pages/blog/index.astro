---
import MainLayout from '../../layouts/MainLayout.astro';
import { blogPosts } from '../../data/blogPosts';

const posts = blogPosts;
---

<MainLayout 
  title="Towing Blog | All Hours Towing Macon GA"
  description="Towing tips, roadside safety guides and local Macon GA advice from All Hours Towing Macon GA. Call (478) 500-8118."
>
  <section class="section bg-towing-dark text-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">Towing Blog</h1>
        <p class="text-xl text-gray-300">
          Expert towing tips, roadside safety guides, and local Macon GA towing advice
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <h2 class="text-2xl font-bold mb-6">All Posts</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <article class="bg-white rounded-lg overflow-hidden shadow-soft hover:shadow-elevated transition-all duration-300 border border-gray-100">
            <div class="p-6">
              <span class="text-towing-red text-xs font-medium uppercase tracking-wider">{post.category}</span>
              <h3 class="text-lg font-bold mt-2 mb-3">{post.title}</h3>
              <p class="text-towing-gray text-sm mb-4">{post.excerpt}</p>
              <a href={`/blog/${post.slug}`} class="text-towing-red font-medium hover:underline inline-flex items-center text-sm">
                Read More
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-gray-50">
    <div class="container text-center">
      <h2 class="text-2xl font-bold mb-4">Need Emergency Help?</h2>
      <p class="text-towing-gray mb-8 max-w-xl mx-auto">
        Don't wait - call us immediately for 24/7 emergency towing service throughout South Atlanta and Middle Georgia.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="tel:+14785008118" class="btn-primary">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Call Macon: (478) 500-8118
        </a>
        <a href="tel:+14785008118" class="btn-primary">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Call Warner Robins: (478) 500-8118
        </a>
      </div>
    </div>
  </section>
</MainLayout>
