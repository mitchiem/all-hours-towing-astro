---
import MainLayout from '../../layouts/MainLayout.astro';
import { blogPosts } from '../../data/blogPosts';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;

const articleSchema = post.articleSchema;

const blogBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://allhourstowingmaconga.com/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://allhourstowingmaconga.com/blog" },
    { "@type": "ListItem", "position": 3, "name": post.title }
  ]
};
---

<MainLayout 
  title={`${post.title} | All Hours Towing Blog`}
  description={post.excerpt}
  schema={{"@graph": [articleSchema, blogBreadcrumbSchema]}}
>
  <section class="section bg-towing-dark text-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <nav class="text-sm mb-4">
          <a href="/" class="text-gray-300 hover:text-white">Home</a>
          <span class="mx-2">/</span>
          <a href="/blog" class="text-gray-300 hover:text-white">Blog</a>
          <span class="mx-2">/</span>
          <span class="text-white">{post.title}</span>
        </nav>
        <span class="inline-block bg-towing-red/20 text-towing-red text-sm font-medium px-3 py-1 rounded-full mb-4">{post.category}</span>
        <h1 class="text-3xl md:text-4xl font-bold mb-4">{post.title}</h1>
        <p class="text-xl text-gray-300">{post.excerpt}</p>
        <p class="text-gray-400 text-sm mt-4">{post.date}</p>
        <p class="text-gray-400 text-xs">Last updated: {post.date}</p>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        {post.fullContent && (
          <div class="prose max-w-none mb-8" set:html={post.fullContent} />
        )}

        {!post.fullContent && (
          <div class="prose max-w-none mb-8">
            <p class="text-towing-gray text-lg mb-6">
              All Hours Towing offers comprehensive towing and roadside assistance services throughout Middle Georgia.
              Our 3rd generation family-owned business has been serving the region for decades with reliable, professional service.
            </p>
          </div>
        )}

        <hr class="my-12 border-gray-200" />
        
        <div class="bg-gray-50 rounded-lg p-8 text-center">
          <h3 class="text-xl font-bold mb-4">Need Emergency Help?</h3>
          <p class="text-towing-gray mb-6">Don't wait - call us immediately for 24/7 emergency towing service.</p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="tel:+14785008118" class="btn-primary">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              Call (478) 500-8118
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-gray-50">
    <div class="container text-center">
      <a href="/blog" class="text-towing-red font-medium hover:underline inline-flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Back to Blog
      </a>
    </div>
  </section>
</MainLayout>
