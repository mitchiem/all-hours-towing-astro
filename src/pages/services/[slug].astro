      { question: "What are Georgia's towing laws I should know?", answer: "Georgia's Move Over Law requires drivers to move over for stationary vehicles with flashing lights—including tow trucks. You also have the right to choose your towing company unless law enforcement directs otherwise." },
      { question: "What should I do immediately after a breakdown on I-75?", answer: "Move safely to the shoulder, turn on hazard lights, stay in your vehicle if on the highway, and call All Hours Towing at (478) 500-8118. Note the nearest mile marker or exit number to help us find you faster." }
    ]
  },
  default: {
    longTitle: "",
    subtitle: "",
    longDescription: ``,
    faqs: []
  }
};

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const serviceInfo = serviceSlugs[service.slug] || serviceSlugs.default;
const serviceSpecificTitle = `${service.title} in Macon GA | All Hours Towing | (478) 500-8118`;
const pageTitle = serviceInfo.longTitle || serviceSpecificTitle;
const pageDescription = `${service.fullDescription} Call All Hours Towing Macon GA at (478) 500-8118 for fast, reliable ${service.title.toLowerCase()} throughout Macon, Warner Robins & Byron.`;
const serviceBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://allhourstowingmaconga.com/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://allhourstowingmaconga.com/services" },
    { "@type": "ListItem", "position": 3, "name": "${service.title}" }
  ]
};

