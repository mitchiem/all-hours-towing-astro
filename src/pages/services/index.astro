---
import MainLayout from '../../layouts/MainLayout.astro';
import { services } from '../../data/services';
---

<MainLayout 
  title="Our Services | All Hours Towing"
  description="Full-service towing and recovery in Middle Georgia. Light duty, heavy duty, roadside assistance, motorcycle towing, disaster recovery, and more. Available 24/7."
>
  <section class="section bg-towing-dark text-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">Our Services</h1>
        <p class="text-xl text-gray-300">
          Comprehensive towing and recovery solutions for all your needs
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((service) => (
          <div class="bg-white rounded-lg p-6 shadow-soft hover:shadow-elevated transition-all duration-300 border border-gray-100">
            <div class="service-icon mb-4">
              <svg class="w-8 h-8 text-towing-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <h3 class="text-xl font-bold mb-3">{service.title}</h3>
            <p class="text-towing-gray mb-4">{service.description}</p>
            <p class="text-towing-gray text-sm mb-6">{service.fullDescription}</p>
            <a href={`/services/${service.slug}`} class="text-towing-red font-medium hover:underline inline-flex items-center">
              Learn More
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-gray-50">
    <div class="container">
      <div class="bg-towing-dark text-white rounded-lg p-8 md:p-12 text-center">
        <h2 class="text-3xl font-bold mb-4">Need Emergency Service?</h2>
        <p class="text-gray-300 mb-8 max-w-2xl mx-auto">
          Our team is available 24/7 for emergency towing and roadside assistance. Don't wait - call us now!
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="tel:+14785008118" class="btn-primary">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call Macon: (478) 500-8118
          </a>
          <a href="tel:+14785008118" class="btn-primary">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call Warner Robins: (478) 500-8118
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>