---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout 
  title="Page Not Found | All Hours Towing"
  description="The page you're looking for couldn't be found."
>
  <section class="section bg-towing-dark text-white min-h-[60vh] flex items-center">
    <div class="container text-center">
      <h1 class="text-6xl md:text-8xl font-bold mb-6">404</h1>
      <h2 class="text-2xl md:text-3xl font-bold mb-4">Page Not Found</h2>
      <p class="text-gray-300 mb-8 max-w-xl mx-auto">
        Sorry, we couldn't find the page you're looking for. It may have been moved or doesn't exist.
      </p>
      <div class="flex flex-wrap justify-center gap-4 mb-8">
        <a href="/" class="btn-primary">Go Home</a>
        <a href="tel:+14785008118" class="btn-primary bg-green-600 hover:bg-green-700">Call Now (478) 500-8118</a>
        <a href="/contact" class="btn-outline border-white text-white hover:bg-white hover:text-towing-dark">Contact Us</a>
      </div>
      <div class="mt-8">
        <h3 class="text-xl font-semibold mb-4">Popular Services</h3>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/services/emergency-towing" class="px-3 py-2 bg-white/10 rounded hover:bg-white/20 text-sm">Emergency Towing</a>
          <a href="/services/roadside-assistance" class="px-3 py-2 bg-white/10 rounded hover:bg-white/20 text-sm">Roadside Assistance</a>
          <a href="/services/flatbed-towing" class="px-3 py-2 bg-white/10 rounded hover:bg-white/20 text-sm">Flatbed Towing</a>
          <a href="/services/medium-duty-towing" class="px-3 py-2 bg-white/10 rounded hover:bg-white/20 text-sm">Medium Duty</a>
          <a href="/locations/macon" class="px-3 py-2 bg-white/10 rounded hover:bg-white/20 text-sm">Macon Towing</a>
          <a href="/faq" class="px-3 py-2 bg-white/10 rounded hover:bg-white/20 text-sm">FAQ</a>
        </div>
      </div>
      <div class="mt-8">
        <p class="text-sm text-gray-400">Or visit our <a href="/sitemap.xml" class="underline">sitemap</a> for a full list of pages.</p>
      </div>
    </div>
  </section>
</MainLayout>