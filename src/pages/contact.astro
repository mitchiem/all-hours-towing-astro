---
const contactPageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "name": "Contact All Hours Towing Macon GA",
      "url": "https://allhourstowingmaconga.com/contact"
    },
    {
      "@type": "LocalBusiness",
      "name": "All Hours Towing Macon GA",
      "url": "https://allhourstowingmaconga.com",
      "telephone": "+1-478-500-8118",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "450 Martin Luther King Jr. Blvd",
        "addressLocality": "Macon",
        "addressRegion": "GA",
        "postalCode": "31201",
        "addressCountry": "US"
      },
      "geo": { "@type": "GeoCoordinates", "latitude": 32.8355, "longitude": -83.6254 },
      "image": "https://allhourstowingmaconga.com/og-image.webp",
      "openingHoursSpecification": [{"@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"], "opens": "00:00", "closes": "23:59"}]
    }
  ]
};
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Contact All Hours Towing Macon GA | 24/7 Towing Service"
  description="Contact All Hours Towing Macon GA for 24/7 towing in Macon, Warner Robins & Byron. 450 MLK Jr Blvd, Macon GA. Call (478) 500-8118."
  schema={contactPageSchema}
>
  <section class="section bg-towing-dark text-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">Contact All Hours Towing Macon GA</h1>
        <p class="text-xl text-gray-300">
          Available 24/7 for emergency towing and roadside assistance
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-2xl font-bold mb-6">Get in Touch</h2>
        <div class="space-y-6 text-left max-w-md mx-auto">
          <div class="flex items-start gap-4">
            <div class="bg-towing-red/10 p-3 rounded-full">
              <svg class="w-6 h-6 text-towing-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <h3 class="font-bold mb-1">Address</h3>
              <p class="text-towing-gray">450 Martin Luther King Jr. Blvd, Macon, GA 31201</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="bg-towing-red/10 p-3 rounded-full">
              <svg class="w-6 h-6 text-towing-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <div>
              <h3 class="font-bold mb-1">Phone</h3>
              <a href="tel:+14785008118" class="text-towing-red font-bold text-lg hover:underline">(478) 500-8118</a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="bg-towing-red/10 p-3 rounded-full">
              <svg class="w-6 h-6 text-towing-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
              <h3 class="font-bold mb-1">Hours</h3>
              <p class="text-towing-gray">Open 24 hours a day, 7 days a week — including holidays</p>
            </div>
          </div>
        </div>

        <div class="mt-10">
          <a href="tel:+14785008118" class="btn-primary text-lg px-8 py-4">
            <svg class="w-5 h-5 mr-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call Now
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
