---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import VideoSection from '../components/VideoSection.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Testimonials from '../components/Testimonials.astro';
import OurStory from '../components/OurStory.astro';
import EmergencyTips from '../components/EmergencyTips.astro';
import ContactCTA from '../components/ContactCTA.astro';
---

<MainLayout
  title="All Hours Towing Macon GA | 24/7 Emergency Towing & Roadside Assistance"
  description="24/7 emergency towing and roadside assistance in Macon, Warner Robins & Byron GA. 15-min average arrival, flatbed and medium duty. Call (478) 500-8118."
>
  <Hero />
  <VideoSection />
  
  <!-- Service Grid with 4 core services -->
  <section class="section bg-white">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-towing-dark mb-4">Our Towing & Recovery Services</h2>
        <p class="text-towing-gray text-lg max-w-2xl mx-auto">Professional towing and roadside assistance throughout Macon, Warner Robins, and Byron. 15-minute average arrival time.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <a href="/services/emergency-towing" class="block p-6 bg-gray-50 rounded-lg hover:shadow-lg transition-shadow border border-gray-100">
          <h3 class="text-xl font-bold mb-2">24/7 Emergency Towing</h3>
          <p class="text-towing-gray">Stranded at 3 AM? Our emergency dispatch gets a truck to you in 15 minutes or less.</p>
        </a>
        <a href="/services/roadside-assistance" class="block p-6 bg-gray-50 rounded-lg hover:shadow-lg transition-shadow border border-gray-100">
          <h3 class="text-xl font-bold mb-2">Roadside Assistance</h3>
          <p class="text-towing-gray">Jump starts, lockouts, flat tires, fuel delivery. We handle it all.</p>
        </a>
        <a href="/services/medium-duty-towing" class="block p-6 bg-gray-50 rounded-lg hover:shadow-lg transition-shadow border border-gray-100">
          <h3 class="text-xl font-bold mb-2">Medium Duty Towing</h3>
          <p class="text-towing-gray">Specialized equipment for box trucks, delivery vans, RVs, and commercial vehicles up to 26,000 lbs.</p>
        </a>
        <a href="/services/flatbed-towing" class="block p-6 bg-gray-50 rounded-lg hover:shadow-lg transition-shadow border border-gray-100">
          <h3 class="text-xl font-bold mb-2">Flatbed Towing</h3>
          <p class="text-towing-gray">Damage-free transport for luxury cars, AWD vehicles, and low-clearance sports cars.</p>
        </a>
      </div>
      <div class="text-center mt-8">
        <a href="/services" class="btn-primary">View All Towing Services</a>
      </div>
    </div>
  </section>

  <!-- Service Areas Section - Single Macon location card -->
  <section class="section bg-gray-50">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-towing-dark mb-4">Serving Macon & Middle Georgia</h2>
        <p class="text-towing-gray text-lg max-w-2xl mx-auto">
          Fast response times from our Macon base. Serving Macon, Warner Robins, Byron, and surrounding communities.
        </p>
      </div>
      <div class="max-w-2xl mx-auto">
        <div class="bg-white p-8 rounded-lg shadow-soft">
          <h3 class="text-2xl font-bold mb-4">Macon & Middle Georgia</h3>
          <p class="text-towing-gray mb-4">
            <strong>Address:</strong> 450 Martin Luther King Jr. Blvd, Macon, GA 31201<br>
            <strong>Phone:</strong> <a href="tel:+14785008118" class="text-towing-red hover:underline">(478) 500-8118</a>
          </p>
          <p class="text-towing-gray mb-4">
            Fast response times from our Macon base. Serving Macon, Warner Robins, Byron, and surrounding communities.
          </p>
          <ul class="space-y-2 text-towing-gray">
            <li class="flex items-center"><span class="text-towing-red mr-2">✓</span> Average response: 15-20 minutes</li>
            <li class="flex items-center"><span class="text-towing-red mr-2">✓</span> I-75 & I-16 corridor coverage</li>
            <li class="flex items-center"><span class="text-towing-red mr-2">✓</span> Downtown Macon location</li>
          </ul>
          <a href="/locations/macon" class="btn-primary mt-6 inline-block">View Macon Service Area</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Signals -->
  <section class="section bg-towing-dark text-white">
    <div class="container">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-4xl font-bold text-towing-red mb-2">15 min</div>
          <div class="text-gray-300">Avg. Arrival Time</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-towing-red mb-2">24/7</div>
          <div class="text-gray-300">Always Available</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-towing-red mb-2">4.9 ★</div>
          <div class="text-gray-300">Google Rating (127 reviews)</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-towing-red mb-2">10,000+</div>
          <div class="text-gray-300">Vehicles Recovered</div>
        </div>
      </div>
    </div>
  </section>

  <WhyChooseUs />

<!-- Internal Links to Key Pages -->
<section class="section bg-white">
  <div class="container">
    <div class="text-center mb-8">
      <h2 class="text-2xl font-bold">Explore Our Services</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 max-w-4xl mx-auto text-center">
      <a href="/services/emergency-towing" class="text-towing-red hover:underline font-medium">Emergency Towing</a>
      <a href="/services/roadside-assistance" class="text-towing-red hover:underline font-medium">Roadside Assistance</a>
      <a href="/services/medium-duty-towing" class="text-towing-red hover:underline font-medium">Medium Duty</a>
      <a href="/services/flatbed-towing" class="text-towing-red hover:underline font-medium">Flatbed Towing</a>
      <a href="/services/macon-towing-guide" class="text-towing-red hover:underline font-medium">Towing Guide</a>
    </div>
    <div class="grid grid-cols-3 gap-4 max-w-md mx-auto text-center mt-4">
      <a href="/locations/macon" class="text-towing-red hover:underline font-medium">Macon Towing</a>
      <a href="/locations/warner-robins" class="text-towing-red hover:underline font-medium">Warner Robins</a>
      <a href="/locations/byron" class="text-towing-red hover:underline font-medium">Byron Towing</a>
    </div>
    <p class="text-center mt-4 text-sm text-gray-600">
      Compare <a href="/guides/towing-company-guide-macon-ga/" class="text-towing-red hover:underline font-medium">towing companies Macon GA</a> — rates, laws, and how to choose.
    </p>
  </div>
</section>
  <Testimonials />
  <OurStory />
  <EmergencyTips />

<!-- Homepage FAQ Section -->
<section class="section bg-gray-50">
  <div class="container">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-8">Frequently Asked Towing Questions in Macon, GA</h2>
      <div class="space-y-4">
        <div class="bg-white p-6 rounded-lg shadow-soft">
          <h3 class="font-bold text-lg mb-2">How fast can you arrive for towing in Macon, GA?</h3>
          <p class="text-towing-gray">Our average response time is 15 minutes throughout Macon, Warner Robins, and Byron. We dispatch from our central Macon location at 450 Martin Luther King Jr. Blvd.</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-soft">
          <h3 class="font-bold text-lg mb-2">Do you handle medium-duty towing?</h3>
          <p class="text-towing-gray">Yes! We handle medium-duty towing for box trucks, delivery vans, RVs, and commercial vehicles up to 26,000 lbs with specialized equipment.</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-soft">
          <h3 class="font-bold text-lg mb-2">Is All Hours Towing Macon GA available 24/7?</h3>
          <p class="text-towing-gray">Absolutely. We are open 24 hours a day, 7 days a week, 365 days a year. A live dispatcher answers every call at (478) 500-8118.</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-soft">
          <h3 class="font-bold text-lg mb-2">What areas do you serve?</h3>
          <p class="text-towing-gray">We serve Macon, Warner Robins, Byron, and surrounding Middle Georgia communities. Our trucks cover the I-75 and I-16 corridors throughout Bibb, Houston, and Peach counties.</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-soft">
          <h3 class="font-bold text-lg mb-2">Do you offer flatbed towing?</h3>
          <p class="text-towing-gray">Yes. We recommend flatbed towing for all-wheel-drive vehicles, luxury cars, and sports cars with low ground clearance. Our flatbeds keep all four wheels off the road for damage-free transport.</p>
        </div>
      </div>
    </div>
  </div>
</section>
  <ContactCTA />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={`{
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "Emergency Towing Tips",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Move to Safety",
        "text": "If possible, move your vehicle to the side of the road away from traffic. Turn on hazard lights and set up warning triangles if available."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Stay in Your Vehicle",
        "text": "If you're on a busy road or highway, it's safest to remain in your vehicle with seatbelts fastened while waiting for assistance."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Call for Help",
        "text": "Contact us at (478) 500-8118 for immediate assistance. Be ready to provide your location, vehicle details, and the nature of your emergency."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Share Your Location",
        "text": "Use your phone's GPS to share your exact location with our towing team to ensure they can find you quickly."
      },
      {
        "@type": "HowToStep",
        "position": 5,
        "name": "Have Documentation Ready",
        "text": "Prepare your driver's license, vehicle registration, and insurance information for when the tow truck arrives."
      },
      {
        "@type": "HowToStep",
        "position": 6,
        "name": "Take Vehicle Photos",
        "text": "If involved in an accident, take photos of your vehicle's condition before it's towed for insurance purposes."
      }
    ]
  }`} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "AutoTowingService",
    "name": "All Hours Towing Macon GA",
    "description": "24/7 emergency towing, roadside assistance, medium duty & flatbed towing. Serving Macon, Warner Robins & Byron GA. 15-min average arrival. 4.9 stars (127 reviews).",
    "url": "https://allhourstowingmaconga.com",
    "telephone": "+1-478-500-8118",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "450 Martin Luther King Jr. Blvd",
      "addressLocality": "Macon",
      "addressRegion": "GA",
      "postalCode": "31201",
      "addressCountry": "US"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 32.8355,
      "longitude": -83.6254
    },
    "areaServed": [
      { "@type": "City", "name": "Macon" },
      { "@type": "City", "name": "Warner Robins" },
      { "@type": "City", "name": "Byron" }
    ],
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
        "opens": "00:00",
        "closes": "23:59"
      }
    ],
    "image": "https://allhourstowingmaconga.com/og-image.webp",
    "logo": "https://allhourstowingmaconga.com/og-image.webp",
    "sameAs": [],
    "keywords": "towing Macon GA, emergency towing, roadside assistance, flatbed towing, medium duty towing, 24/7 towing, Warner Robins towing, Byron towing"
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "url": "https://allhourstowingmaconga.com",
    "name": "All Hours Towing Macon GA",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "https://allhourstowingmaconga.com/search?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  })} />

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "All Hours Towing Macon GA",
  "url": "https://allhourstowingmaconga.com",
  "telephone": "+1-478-500-8118",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "450 Martin Luther King Jr. Blvd",
    "addressLocality": "Macon",
    "addressRegion": "GA",
    "postalCode": "31201",
    "addressCountry": "US"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 32.8355, "longitude": -83.6254 },
  "openingHoursSpecification": [{"@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"], "opens": "00:00", "closes": "23:59"}]
})} />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {"@type": "Question", "name": "How fast can you arrive for towing in Macon, GA?", "acceptedAnswer": {"@type": "Answer", "text": "Our average response time is 15 minutes throughout Macon, Warner Robins, and Byron. We dispatch from our central Macon location at 450 Martin Luther King Jr. Blvd."}},
    {"@type": "Question", "name": "Do you handle medium-duty towing?", "acceptedAnswer": {"@type": "Answer", "text": "Yes! We handle medium-duty towing for box trucks, delivery vans, RVs, and commercial vehicles up to 26,000 lbs with specialized equipment."}},
    {"@type": "Question", "name": "Is All Hours Towing Macon GA available 24/7?", "acceptedAnswer": {"@type": "Answer", "text": "Absolutely. We are open 24 hours a day, 7 days a week, 365 days a year. A live dispatcher answers every call at (478) 500-8118."}},
    {"@type": "Question", "name": "What areas do you serve?", "acceptedAnswer": {"@type": "Answer", "text": "We serve Macon, Warner Robins, Byron, and surrounding Middle Georgia communities. Our trucks cover the I-75 and I-16 corridors throughout Bibb, Houston, and Peach counties."}},
    {"@type": "Question", "name": "Do you offer flatbed towing?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. We recommend flatbed towing for all-wheel-drive vehicles, luxury cars, and sports cars with low ground clearance. Our flatbeds keep all four wheels off the road for damage-free transport."}}
  ]
})} />
</MainLayout>
