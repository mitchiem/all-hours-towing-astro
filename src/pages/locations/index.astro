---
import MainLayout from '../../layouts/MainLayout.astro';
import { allCities } from '../../data/cities';
---

<MainLayout 
  title="Service Locations | All Hours Towing"
  description="24/7 Towing and Recovery in Macon, Macon, Fort Valley & surrounding areas. Local family-owned company with fast response times and professional service."
>
  <section class="section bg-towing-dark text-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">Service Locations</h1>
        <p class="text-xl text-gray-300">
          Professional towing and recovery services throughout South Atlanta and Middle Georgia
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <div class="lg:col-span-3">
          <div class="mb-12">
            <div class="flex items-center gap-3 mb-6">
              <svg class="w-6 h-6 text-towing-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
              <h2 class="text-2xl font-bold">Service Locations</h2>
            </div>
             <p class="text-towing-gray mb-6">Serving Macon, Warner Robins, and Byron from our Macon headquarters at 450 Martin Luther King Jr. Blvd. Fast response to all surrounding communities.</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {allCities.map((city) => (
                <a href={`/locations/${city.slug}`} class="bg-white rounded-lg p-5 shadow-soft hover:shadow-elevated transition-all border border-gray-100 group">
                  <h3 class="font-bold text-lg mb-2 group-hover:text-towing-red transition-colors">{city.name}, {city.state}</h3>
                  <p class="text-towing-gray text-sm mb-3">{city.description}</p>
                  <span class="text-towing-red text-sm font-medium flex items-center gap-1">
                    View Details
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </span>
                </a>
              ))}
            </div>
          </div>

        </div>

        <div>
          <div class="bg-gray-50 rounded-lg p-6 sticky top-24">
            <h3 class="text-xl font-bold mb-4">Contact Us</h3>
            <div class="space-y-4 mb-6">
              <div class="bg-white rounded-lg p-4">
                <p class="font-medium mb-1">Macon Location</p>
                <p class="text-towing-gray text-sm mb-1">450 Martin Luther King Jr. Blvd</p>
                <p class="text-towing-gray text-sm mb-2">Macon, GA 31201</p>
                <a href="tel:+14785008118" class="text-towing-red font-bold text-lg">(478) 500-8118</a>
              </div>
            </div>
            <hr class="my-4 border-gray-300" />
            <p class="text-towing-gray text-sm text-center">Available 24/7 for emergency towing</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-gray-50">
    <div class="container text-center">
      <h2 class="text-2xl font-bold mb-4">Need Emergency Help?</h2>
      <p class="text-towing-gray mb-6 max-w-2xl mx-auto">
        Call us 24/7 for emergency towing and roadside assistance throughout Macon, Warner Robins, and Byron.
      </p>
      <a href="tel:+14785008118" class="btn-primary">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        Call (478) 500-8118
      </a>
    </div>
  </section>
</MainLayout>