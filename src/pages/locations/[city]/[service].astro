---
import MainLayout from '../../../layouts/MainLayout.astro';
import { allCities } from '../../../data/cities';
import { services } from '../../../data/services';

export function getStaticPaths() {
  const paths: { params: { city: string; service: string }; props: { city: any; service: any } }[] = [];
  for (const city of allCities) {
    for (const service of services) {
      paths.push({ params: { city: city.slug, service: service.slug }, props: { city, service } });
    }
  }
  return paths;
}

const { city, service } = Astro.props;

const serviceTitle = service.shortTitle || service.title;
const pageTitle = `${serviceTitle} in ${city.name} GA | All Hours Towing | (478) 500-8118`;
const pageDescription = `${service.description} Available 24/7 in ${city.name}, GA and nearby Middle Georgia. Call (478) 500-8118.`;

const localDetails: Record<string, string> = {
  macon: 'Dispatch runs from 450 Martin Luther King Jr. Blvd in downtown Macon, placing trucks minutes from I-75, I-16 and I-475 for a fast response across Macon-Bibb County.',
  'warner-robins': 'A satellite staging point near Warner Robins keeps a truck close to Watson Boulevard, Russell Parkway, Robins AFB and the surrounding Houston County corridors.',
  byron: 'Our Macon base is just 12 miles away via I-75, so a truck reaches Byron, exit 146/149 and Peach County quickly, day or night.'
};

const roads = city.majorRoads.join(', ');

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${serviceTitle} in ${city.name}, GA`,
  description: pageDescription,
  serviceType: service.title,
  provider: {
    '@type': 'AutoTowingService',
    name: 'All Hours Towing Macon GA',
    url: 'https://allhourstowingmaconga.com',
    telephone: '+1-478-500-8118',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '450 Martin Luther King Jr. Blvd',
      addressLocality: 'Macon',
      addressRegion: 'GA',
      postalCode: '31201',
      addressCountry: 'US'
    }
  },
  areaServed: { '@type': 'City', name: `${city.name}, GA` },
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: `https://allhourstowingmaconga.com/locations/${city.slug}/${service.slug}`,
    servicePhone: '+1-478-500-8118'
  }
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://allhourstowingmaconga.com/' },
    { '@type': 'ListItem', position: 2, name: 'Locations', item: 'https://allhourstowingmaconga.com/locations' },
    { '@type': 'ListItem', position: 3, name: city.name, item: `https://allhourstowingmaconga.com/locations/${city.slug}` },
    { '@type': 'ListItem', position: 4, name: serviceTitle }
  ]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `How fast can you provide ${serviceTitle.toLowerCase()} in ${city.name}, GA?`,
      acceptedAnswer: { '@type': 'Answer', text: `Average response in ${city.name} is 15-20 minutes. ${localDetails[city.slug] || 'Trucks are staged for fast deployment across the area.'}` }
    },
    {
      '@type': 'Question',
      name: `What areas around ${city.name} do you cover for ${serviceTitle.toLowerCase()}?`,
      acceptedAnswer: { '@type': 'Answer', text: `We cover ${city.name}, ${city.region}, and nearby communities via ${roads}. Coverage runs 24/7 along every major corridor.` }
    },
    {
      '@type': 'Question',
      name: `How much does ${serviceTitle.toLowerCase()} cost in ${city.name}?`,
      acceptedAnswer: { '@type': 'Answer', text: `Pricing depends on distance, vehicle type and the equipment required. Call (478) 500-8118 and we quote the full price before dispatch, with no hidden fees.` }
    }
  ]
};
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  schema={{ '@graph': [serviceSchema, breadcrumbSchema, faqSchema] }}
>
  <section class="section bg-towing-dark text-white">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <nav class="text-sm mb-4">
          <a href="/" class="text-gray-300 hover:text-white">Home</a>
          <span class="mx-2">/</span>
          <a href="/locations" class="text-gray-300 hover:text-white">Locations</a>
          <span class="mx-2">/</span>
          <a href={`/locations/${city.slug}`} class="text-gray-300 hover:text-white">{city.name}</a>
          <span class="mx-2">/</span>
          <span class="text-white">{serviceTitle}</span>
        </nav>
        <h1 class="text-3xl md:text-5xl font-bold mb-6">{service.title} in {city.name}, GA</h1>
        <p class="text-xl text-gray-300">{service.description}</p>
        <div class="flex flex-wrap justify-center gap-4 mt-8">
          <a href="tel:+14785008118" class="btn-primary">Call (478) 500-8118</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold mb-4">{serviceTitle} in {city.name}, Georgia</h2>
        <p class="text-towing-gray mb-6">{service.fullDescription}</p>

        <h2 class="text-2xl font-bold mb-4">Local {serviceTitle} Coverage Around {city.name}</h2>
        <p class="text-towing-gray mb-6">
          {localDetails[city.slug] || 'Trucks are staged for fast deployment across the area.'} Key roads we cover include {roads}.
          Whether you are on a highway shoulder, in a parking lot or at home, call (478) 500-8118 for immediate {serviceTitle.toLowerCase()} in {city.name}, GA.
        </p>

        <h2 class="text-2xl font-bold mb-4">Frequently Asked Questions</h2>
        <div class="space-y-4 mb-10">
          <div class="bg-gray-50 rounded-lg p-5">
            <h3 class="font-bold mb-2">How fast can you provide {serviceTitle.toLowerCase()} in {city.name}, GA?</h3>
            <p class="text-towing-gray">Average response in {city.name} is 15-20 minutes. {localDetails[city.slug] || 'Trucks are staged for fast deployment across the area.'}</p>
          </div>
          <div class="bg-gray-50 rounded-lg p-5">
            <h3 class="font-bold mb-2">What areas around {city.name} do you cover?</h3>
            <p class="text-towing-gray">We cover {city.name}, {city.region}, and nearby communities via {roads}. Coverage runs 24/7 along every major corridor.</p>
          </div>
          <div class="bg-gray-50 rounded-lg p-5">
            <h3 class="font-bold mb-2">How much does {serviceTitle.toLowerCase()} cost in {city.name}?</h3>
            <p class="text-towing-gray">Pricing depends on distance, vehicle type and the equipment required. Call (478) 500-8118 and we quote the full price before dispatch, with no hidden fees.</p>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-6 mb-10">
          <div class="bg-gray-50 rounded-lg p-6">
            <h3 class="font-bold mb-3">Related {city.name} Services</h3>
            <ul class="space-y-2">
              {services.filter((s) => s.slug !== service.slug).slice(0, 6).map((s) => (
                <li><a href={`/locations/${city.slug}/${s.slug}`} class="text-towing-red hover:underline">{s.shortTitle || s.title}</a></li>
              ))}
            </ul>
          </div>
          <div class="bg-gray-50 rounded-lg p-6">
            <h3 class="font-bold mb-3">More About {city.name}</h3>
            <ul class="space-y-2">
              <li><a href={`/locations/${city.slug}`} class="text-towing-red hover:underline">{city.name} Towing Services</a></li>
              <li><a href={`/services/${service.slug}`} class="text-towing-red hover:underline">{service.title} in Macon, GA</a></li>
            </ul>
          </div>
        </div>

        <div class="bg-towing-red text-white rounded-lg p-8 text-center">
          <h3 class="text-xl font-bold mb-3">Need {serviceTitle} in {city.name} Right Now?</h3>
          <p class="mb-6">24/7 live dispatch. Fast, transparent pricing across Middle Georgia.</p>
          <a href="tel:+14785008118" class="inline-block bg-white text-towing-red font-bold px-6 py-3 rounded-lg">Call (478) 500-8118</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
