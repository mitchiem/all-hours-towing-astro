};


const localInfo = cityServiceContent[city.slug]?.localInfo || city.localInfo || `We provide professional towing and recovery services throughout ${city.name} and surrounding areas.`;

const isMaconArea = city.region === 'Macon Area';
const locationDescription = `24/7 towing in ${city.name}, GA by All Hours Towing Macon GA. Fast emergency towing & roadside assistance. Call (478) 500-8118.`;
const locationTitle = `Towing in ${city.name}, GA | All Hours Towing Macon | 24/7`;

const nearbyCities = allCities.filter(c => 
  c.slug !== city.slug && 
  (c.region === city.region || city.nearbyLocations.includes(c.slug))
).slice(0, 6);

const localBusinessSchema = (city && ['macon','warner-robins','byron'].includes(city.slug)) ? {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "All Hours Towing Macon GA",
  "description": `24/7 towing and roadside assistance in ${city.name}, GA. All Hours Towing Macon GA serves ${city.name} with fast, reliable emergency towing, flatbed transport, and accident recovery.`,
  "url": `https://allhourstowingmaconga.com/locations/${city.slug}`,
  "telephone": "+1-478-500-8118",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "450 Martin Luther King Jr. Blvd",
    "addressLocality": "Macon",
    "addressRegion": "GA",
    "postalCode": "31201",
    "addressCountry": "US"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 32.8355, "longitude": -83.6254 },
  "areaServed": { "@type": "City", "name": city.name },
  "openingHoursSpecification": [{"@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"], "opens": "00:00", "closes": "23:59"}]
} : (city ? {
  "@context": "https://schema.org",
  "@type": "AutoTowingService",
  "name": `All Hours Towing Macon GA - ${city.name}`,
  "telephone": "+1-478-500-8118",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": (city.nearestServiceCenter?.address || "450 Martin Luther King Jr. Blvd").split(',')[0],
    "addressLocality": city.name,
    "addressRegion": "GA",
    "addressCountry": "US"
  },
  "areaServed": { "@type": "City", "name": city.name },
  "url": `https://allhourstowingmaconga.com/locations/${city.slug}`
} : {});

const locationBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://allhourstowingmaconga.com/" },
    { "@type": "ListItem", "position": 2, "name": "Locations", "item": "https://allhourstowingmaconga.com/locations" },
    { "@type": "ListItem", "position": 3, "name": city.name, "item": `https://allhourstowingmaconga.com/locations/${city.slug}` }
  ]
};
const faqPageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `How fast can you reach me in ${city.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `We stage trucks near ${city.name}'s major routes including ${city.majorRoads.join(', ')}. Average response time is 30 minutes or less throughout ${city.name} and ${city.region}.`
      }
    },
    {
      "@type": "Question",
      "name": `Do you provide towing on ${city.majorRoads[0]} near ${city.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes! We cover all highways and interstates in and around ${city.name}, including ${city.majorRoads.join(', ')}. Our trucks are stationed near key interchanges for fast dispatch.`
      }
    },
    {
      "@type": "Question",
      "name": `What services do you offer in ${city.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `We provide light and medium duty towing, roadside assistance (lockouts, jumpstarts, fuel delivery), motorcycle towing, accident recovery, and disaster recovery in ${city.name} and throughout ${city.region}.`
      }
    },
    {
      "@type": "Question",
      "name": `Are you available 24 hours in ${city.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes — our dispatchers are live 24/7/365. Call (478) 500-8118 any time day or night for immediate roadside assistance in ${city.name}.`
      }
    },
    {
      "@type": "Question",
      "name": `What areas do you serve near ${city.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `We serve ${city.name}, ${city.region}, and surrounding communities including neighboring cities throughout the area. Our trucks are staged for fast response across the entire service area.`
      }
    }
  ]
};

---

<MainLayout 
  title={locationTitle}
  description={locationDescription}
  schema={{"@graph": [localBusinessSchema, locationBreadcrumbSchema, faqPageSchema]}}
>
  <section class="section bg-towing-dark text-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <nav class="text-sm mb-4">
          <a href="/" class="text-gray-300 hover:text-white">Home</a>
          <span class="mx-2">/</span>
          <a href="/locations" class="text-gray-300 hover:text-white">Locations</a>
          <span class="mx-2">/</span>
          <span class="text-white">{city.name}</span>
        </nav>
        <p class="text-yellow-400 font-medium mb-2">{city.region}</p>
        <h1 class="text-4xl md:text-5xl font-bold mb-4">{city.name} Towing & Roadside Assistance – All Hours Towing</h1>
        <p class="text-xl text-gray-300">{city.description}</p>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2">
          <h2 class="text-2xl font-bold mb-6">Professional Towing in {city.name}</h2>
          
          {
            localInfo.split('\n\n').filter(p => p.trim()).map(paragraph => (
              <p class="text-towing-gray mb-4">{paragraph.trim()}</p>
            ))
          }
          
          <div class="bg-gray-50 rounded-lg p-6 mb-8">
            <h3 class="text-lg font-bold mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-towing-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
              Service Information
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
              <div>
                <p class="text-sm text-towing-gray">Nearest Service Center</p>
                <p class="font-medium">{city.nearestServiceCenter.name}</p>
                <p class="text-sm text-towing-gray">{city.nearestServiceCenter.address}</p>
              </div>
              <div>
                <p class="text-sm text-towing-gray">Distance</p>
                <p class="text-towing-red font-bold">{city.nearestServiceCenter.distance}</p>
              </div>
            </div>
            <p class="text-sm text-towing-gray">
              <strong>Major Roads:</strong> {city.majorRoads.join(', ')}
            </p>
          </div>
          
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Available Services in {city.name}</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {services.map((svc) => (
                <a href={`/locations/${city.slug}/${svc.slug}`} class="bg-white border border-gray-100 rounded-lg p-4 shadow-soft hover:shadow-elevated transition-all flex items-start gap-3">
                  <div class="w-10 h-10 bg-towing-red/10 rounded-full flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-towing-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                  </div>
                  <div>
                    <p class="font-bold text-sm">{svc.title}</p>
                    <p class="text-xs text-towing-gray">{svc.description}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
          
          <div class="space-y-4 mb-8">
            <h3 class="text-lg font-bold">Why Choose All Hours Towing?</h3>
            <ul class="space-y-3">
              {whyChooseContent[city.slug] ? (
                whyChooseContent[city.slug].map((bullet) => (
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-towing-red flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span class="text-towing-gray">{bullet}</span>
                  </li>
                ))
              ) : (
                <>
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-towing-red flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span class="text-towing-gray">24/7 availability - we're always here when you need us</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-towing-red flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span class="text-towing-gray">Fast response times - typically 30 minutes or less</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-towing-red flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span class="text-towing-gray">Professional, certified technicians</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-towing-red flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span class="text-towing-gray">Modern equipment and vehicles</span>
                  </li>
                </>
              )}
            </ul>
          </div>
          <div class="prose max-w-none mb-8">
            <h3 class="text-lg font-bold mb-3">Neighborhood Coverage & ETA in {city.name}</h3>
            <p class="text-towing-gray mb-4">
              We cover all of {city.name} and nearby communities including {nearbyCities.map(n => n.name).join(', ') || 'surrounding areas'}. Our trucks stage near high‑demand corridors ({city.majorRoads.join(', ')}) to keep average response near 30 minutes. Busy drive times and weather can affect ETA; we update you by phone/text while en route.
            </p>
            <p class="text-towing-gray">
              For apartments, gated communities, and retail lots, please share gate codes or landmarks. If you’re roadside, move safely off the travel lane, enable hazard lights, and wait behind a barrier if available until our wrecker arrives.
            </p>
          </div>

          <div class="bg-gray-50 rounded-lg p-6 mb-8">
            <h3 class="text-lg font-bold mb-3">Safety on {city.majorRoads.join(', ')}</h3>
            <p class="text-towing-gray">
              On major roads around {city.name}, use triangles/flares if you have them and avoid standing near traffic. If police are on scene, advise them All Hours Towing is responding. We handle recovery, debris clearing, and transport to your preferred shop.
            </p>
          </div>

          <!-- FAQ Section -->
          <div class="mb-8" itemscope itemtype="https://schema.org/FAQPage">
            <h2 class="text-2xl font-bold mb-4">Frequently Asked Questions — {city.name} Towing</h2>
            <div class="space-y-4">
              <div class="bg-gray-50 rounded-lg p-4">
                <h3 class="font-bold mb-2">How fast can you reach me in {city.name}?</h3>
                <p class="text-towing-gray">We stage trucks near {city.name}'s major routes including {city.majorRoads.join(', ')}. Average response time is 30 minutes or less throughout {city.name} and {city.region}.</p>
              </div>
              <div class="bg-gray-50 rounded-lg p-4">
                <h3 class="font-bold mb-2">Do you provide towing on {city.majorRoads[0]} near {city.name}?</h3>
                <p class="text-towing-gray">Yes! We cover all highways and interstates in and around {city.name}, including {city.majorRoads.join(', ')}. Our trucks are stationed near key interchanges for fast dispatch.</p>
              </div>
              <div class="bg-gray-50 rounded-lg p-4">
                <h3 class="font-bold mb-2">What services do you offer in {city.name}?</h3>
                <p class="text-towing-gray">We provide light and medium duty towing, roadside assistance (lockouts, jumpstarts, fuel delivery), motorcycle towing, accident recovery, and disaster recovery in {city.name} and throughout {city.region}.</p>
              </div>
              <div class="bg-gray-50 rounded-lg p-4">
                <h3 class="font-bold mb-2">Are you available 24 hours in {city.name}?</h3>
                <p class="text-towing-gray">Yes — our dispatchers are live 24/7/365. Call (478) 500-8118 any time day or night for immediate roadside assistance in {city.name}.</p>
