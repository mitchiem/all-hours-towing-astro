  ],
  'roberta': [
    "Crawford County Courthouse and Roberta Depot area",
    "US-341 and US-80 corridors through rural Crawford County",
    "Macon headquarters only 16 miles — rapid response",
    "Crawford County High School zone — safe school traffic handling"
  ],
  'jeffersonville': [
    "Twiggs County Courthouse and I-16 corridor specialists",
    "US-80 and GA-96 through rural Twiggs County",
    "Ocmulgee River area — flood-prone road awareness",
    "Downtown Jeffersonville and North Jeffersonville coverage"
  ],
  'dry-branch': [
    "Twiggs County rural recovery — US-80 and GA-96 corridors",
    "I-16 nearby access for through-traveler breakdowns",
    "Dry Branch Township and surrounding countryside — we're the nearest",
