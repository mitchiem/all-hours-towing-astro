---
import MainLayout from '../../../layouts/MainLayout.astro';
import { allCities } from '../../../data/cities';
import { services } from '../../../data/services';

export function getStaticPaths() {
  return allCities.map((city) => ({
    params: { city: city.slug },
    props: { city }
  }));
}

const { city } = Astro.props;

const cityServiceContent: Record<string, { keywords: string; localInfo: string }> = {
  'macon': {
    keywords: 'Macon towing, Macon roadside assistance, Bibb County tow truck, 24/7 towing Macon GA',
    localInfo: `Macon is the heart of Middle Georgia and the headquarters of All Hours Towing. Our central location at 450 Martin Luther King Jr. Blvd places us just minutes from anywhere in Macon-Bibb County. We serve the entire metro area, from the historic neighborhoods of Ingleside and Vineville to the commercial corridors of Eisenhower Parkway and Riverside Drive.

The Macon-Bibb area is crisscrossed by major highways: I-75 runs north-south through the heart of the city, connecting Macon to Atlanta (80 miles north) and Valdosta (130 miles south). I-16 begins in Macon and runs east to Savannah. I-475 forms a western bypass around the city. These interstates generate heavy commuter and freight traffic daily—and when a breakdown happens on the shoulder, our response time averages 15 minutes.

Local landmarks include the Ocmulgee Mounds National Historical Park, a 2,000-year-old Native American site that draws visitors from across the Southeast. The Cherry Blossom Festival each March brings over 200,000 visitors to Macon, filling streets with pedestrian traffic and out-of-town vehicles. We pre-stage trucks during festival weekends to maintain fast response times. Mercer University, Navicent Health (the region's largest hospital), the Macon Coliseum, and the Tubman Museum are all within our 15-minute response radius.

Macon-Bibb has a mix of urban, suburban, and rural roads. Narrow historic streets in downtown Macon require flatbed towing for low-clearance vehicles. The Ocmulgee River lowlands experience occasional flooding after heavy rains, and our winch-equipped trucks can recover vehicles caught on soft ground or standing water. From the busy I-75/I-16 interchange (exit 165) to the quiet country roads of Lizella and Payne City, our drivers know every shortcut and every safe pull-off.`
  },
  'warner-robins': {
    keywords: 'Warner Robins towing, Warner Robins roadside assistance, Houston County tow truck, Robins AFB towing',
    localInfo: `Warner Robins is Middle Georgia's second-largest city and home to Robins Air Force Base, one of Georgia's largest employers. All Hours Towing provides fast, reliable towing and roadside assistance throughout Warner Robins and Houston County from our Macon headquarters, just 20 miles away via I-75 and GA-247.

Major routes serving Warner Robins include Watson Boulevard (the city's main east-west commercial artery), Russell Parkway, GA-247, and GA-96. I-75 runs just west of the city, providing rapid access to Macon and points south. The Russell Parkway / Watson Boulevard corridor sees heavy commuter traffic during shift changes at Robins AFB, and the Museum of Aviation draws military history enthusiasts from across the country.

Local landmarks include the Museum of Aviation, the Houston Medical Center, and the Galleria Mall area. The base housing developments and surrounding neighborhoods require quick response times, and our drivers know every gate, restricted road, and alternative route on and around Robins AFB. Whether you're stranded on a side road in Eagle Springs or need a tow from the Walmart parking lot on Watson Boulevard, we'll be there in 15-20 minutes.`
  },
  'byron': {
    keywords: 'Byron towing, Byron roadside assistance, Peach County tow truck, I-75 breakdown Byron GA',
    localInfo: `Byron is a growing community in Peach County, known as the "Gateway to the Peach County" and famous for the Big Peach landmark visible from I-75. All Hours Towing serves Byron with 24/7 emergency towing and roadside assistance from our Macon base, just 12 miles away via I-75.

I-75 is Byron's main artery, with exits 146 and 149 providing access to the city. Traffic along I-75 through Byron is a mix of long-haul freight, vacationers heading to Florida, and local commuters. US-41 runs parallel to the interstate, and GA-49 connects Byron to Fort Valley and Macon. These routes see their share of breakdowns, especially during summer heat when batteries fail and tires blow out on the hot asphalt.

Landmarks include North Peach Park, the Peach County High School, and the iconic Big Peach fruit stand. The surrounding rural areas of Peach County feature winding farm roads where vehicles can end up in ditches after dark, and our winch-equipped trucks can handle any off-road recovery. Whether you need a jumpstart at a gas station off exit 149 or emergency towing after a fender-bender on US-41, we'll get to you fast.`
  }
};
