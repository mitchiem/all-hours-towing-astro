---
---

<section class="section bg-background">
  <div class="container">
    <div class="section-title">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">See Our Team in Action</h2>
      <p class="text-lg text-towing-gray max-w-3xl mx-auto">
        Watch how All Hours Towing delivers professional towing and recovery services across South Atlanta and Middle Georgia.
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="relative aspect-video bg-gray-100 rounded-lg overflow-hidden shadow-lg">
        <a href="https://www.youtube.com/watch?v=4Hsc8jBidbE" target="_blank" rel="noopener noreferrer" class="block w-full h-full">
          <img
            src="https://i.ytimg.com/vi/4Hsc8jBidbE/hqdefault.jpg"
            alt="All Hours Towing towing and recovery team video thumbnail"
            class="absolute inset-0 w-full h-full object-cover"
            loading="lazy"
            width={480}
            height={360}
          />
          <div class="absolute inset-0 bg-black/30 hover:bg-black/40 transition-colors flex items-center justify-center">
            <div class="w-16 h-16 md:w-20 md:h-20 bg-red-600 rounded-full flex items-center justify-center shadow-lg">
              <svg class="w-8 h-8 md:w-10 md:h-10 text-white ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
        </a>
      </div>
    </div>

    <div class="mt-8 text-center">
      <p class="text-towing-gray mb-4">
        Ready to experience our professional service? Contact us today!
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="tel:+14785008118" class="btn-primary inline-flex items-center">
          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          Call (478) 500-8118 Now
        </a>
        <a href="https://www.youtube.com/watch?v=4Hsc8jBidbE" target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-towing-dark hover:text-towing-red font-medium">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          Watch Full Video
        </a>
      </div>
    </div>
  </div>
</section>