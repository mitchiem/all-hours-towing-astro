---
const reasons = [
  {
    id: 1,
    icon: 'clock',
    title: '24/7 Availability',
    description: 'We\'re ready to assist you any time of day or night, including weekends and holidays.'
  },
  {
    id: 2,
    icon: 'award',
    title: 'Experienced Team',
    description: 'Our certified professionals have years of experience handling all types of vehicles.'
  },
  {
    id: 3,
    icon: 'thumbsUp',
    title: 'Customer Satisfaction',
    description: 'We prioritize your needs and go the extra mile to ensure your complete satisfaction.'
  },
  {
    id: 4,
    icon: 'dollar',
    description: 'Quality service at trusted service without compromising on service quality.'
  },
  {
    id: 5,
    icon: 'truck',
    title: 'Modern Equipment',
    description: 'We use state-of-the-art towing equipment to ensure your vehicle\'s safety.'
  },
  {
    id: 6,
    icon: 'shield',
    title: 'Fully Insured',
    description: 'Your vehicle is protected with our comprehensive insurance coverage.'
  }
];
---

<section class="section bg-gray-50">
  <div class="container">
    <div class="section-title">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Why Choose All Hours Towing?</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {reasons.map((reason) => (
        <div class="bg-white rounded-lg p-6 shadow-soft transition-all duration-300 hover:shadow-elevated">
          <div class="mb-4 text-towing-red">
            {reason.icon === 'clock' && <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>}
            {reason.icon === 'award' && <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>}
            {reason.icon === 'thumbsUp' && <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>}
            {reason.icon === 'dollar' && <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>}
            {reason.icon === 'truck' && <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>}
            {reason.icon === 'shield' && <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>}
          </div>
          <h3 class="text-xl font-bold mb-3">{reason.title}</h3>
          <p class="text-towing-gray">{reason.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>