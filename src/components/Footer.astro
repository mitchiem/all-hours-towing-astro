---
import { services } from '../data/services';
import { allCities } from '../data/cities';
---

<footer class="bg-towing-dark text-white pt-16 pb-8">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
      <div>
        <h3 class="text-xl font-bold mb-6">All Hours Towing</h3>
        <p class="mb-6 text-gray-300">
          24/7 Professional Towing and Recovery in Macon, Warner Robins & Byron. 15-minute average arrival.
        </p>
        <div class="flex space-x-4">
          <!-- No social media profiles -->
        </div>
      </div>

      <div>
        <h3 class="text-xl font-bold mb-6">Services</h3>
        <ul class="space-y-3">
          {services.map((service) => (
            <li>
              <a href={`/services/${service.slug}`} class="text-gray-300 hover:text-white transition-colors">
                {service.shortTitle}
              </a>
            </li>
          ))}
          <li>
            <a href="/services" class="text-white hover:text-towing-red font-medium transition-colors">
              View All Services
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-xl font-bold mb-6">Locations</h3>
        <ul class="space-y-3">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-1 text-towing-red flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <div>
              <span class="text-gray-300 block">450 Martin Luther King Jr. Blvd, Macon, GA 31201</span>
              <a href="tel:+14785008118" class="text-gray-300 hover:text-white transition-colors text-sm">(478) 500-8118</a>
            </div>
          </li>
          <li class="mt-4">
            <span class="text-white font-medium">Service Areas:</span>
            <div class="flex flex-wrap gap-x-4 gap-y-1 mt-2">
              {allCities.map((city) => (
                <a href={`/locations/${city.slug}`} class="text-gray-300 hover:text-white transition-colors">{city.name}</a>
              ))}
            </div>
          </li>
          <li>
            <a href="/locations" class="text-white hover:text-towing-red font-medium transition-colors">All Locations</a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-xl font-bold mb-6">Contact Us</h3>
        <ul class="space-y-3">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-towing-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <a href="tel:+14785008118" class="text-gray-300 hover:text-white transition-colors">(478) 500-8118</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-towing-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span class="text-gray-300">450 Martin Luther King Jr. Blvd, Macon, GA 31201</span>
          </li>
        </ul>
        <a href="/contact" class="btn-primary mt-6 inline-block">Contact Us</a>
      </div>
    </div>

    <hr class="border-gray-800 mb-8" />

    <div class="text-center mb-6">
      <p class="text-white font-bold text-sm tracking-wide uppercase">ALL HOURS TOWING MACON GA</p>
      <p class="text-gray-400 text-sm mt-1">450 Martin Luther King Jr. Blvd, Macon, GA 31201</p>
      <p class="text-gray-400 text-sm mt-1">
        <a href="tel:+14785008118" class="hover:text-white transition-colors">(478) 500-8118</a>
      </p>
    </div>

    <div class="flex flex-col md:flex-row justify-between items-center">
      <p class="text-gray-400 text-sm mb-4 md:mb-0">&copy; {new Date().getFullYear()} All Hours Towing Macon GA. All rights reserved.</p>
      <button id="scroll-top" class="bg-towing-red p-3 rounded-full text-white hover:bg-red-700 transition-colors cursor-pointer" aria-label="Scroll to top">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
      </button>
    </div>
  </div>
</footer>

<script>
  const scrollBtn = document.getElementById('scroll-top');
  scrollBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
